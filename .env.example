# Never commit your real .env file or API key.
# The application accepts any OpenAI-compatible chat-completions endpoint.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Bearer token expected by the grader/client. Use a long random value.
A2A_BEARER_TOKEN=replace-with-a-long-random-token

# Local development defaults. For Render, prefer a persistent disk or managed DB.
DATABASE_URL=sqlite:///./invoice_agent.db
PUBLIC_BASE_URL=http://127.0.0.1:8000
APP_VERSION=1.0.0
AI_TIMEOUT_SECONDS=35
